{
  "seed": 42,
  "sr": 16000,
  "vad": {
    "model": "silero-vad (pip)",
    "threshold": 0.5,
    "min_speech_duration_ms": 250,
    "min_silence_duration_ms": 100,
    "speech_pad_ms": 30
  },
  "profile": {
    "window_s": 10.0,
    "bin_s": 0.1,
    "end_min_duration_s": 60.0
  },
  "channel": {
    "n_fft": 512,
    "win_length": 400,
    "hop_length": 160,
    "nonspeech_margin_s": 0.2,
    "nonspeech_margin_fallback_s": 0.05,
    "min_nonspeech_frames": 50,
    "bandwidth_energy_fraction": 0.95
  },
  "embedding": {
    "model": "speechbrain/spkrec-ecapa-voxceleb",
    "merge_gap_s": 0.3,
    "min_unit_s": 0.8,
    "max_chunk_s": 3.0,
    "batch_size": 32
  },
  "clustering": {
    "method": "agglomerative, cosine, average linkage, par session (3 tâches)",
    "similarity_threshold": 0.3,
    "similarity_grid": [
      0.2,
      0.3,
      0.4
    ],
    "second_voice_min_s": 3.0,
    "second_voice_grid_s": [
      1.0,
      2.0,
      3.0,
      5.0,
      10.0
    ],
    "main_speaker": "groupe de plus grande durée totale sur la session"
  },
  "shortcut": {
    "split": "Train",
    "n_splits": 5,
    "n_repeats": 5,
    "n_permutations": 1000,
    "model": "SimpleImputer(median) + StandardScaler + LogisticRegression(class_weight=balanced)",
    "channel_vars": [
      "noise_db",
      "snr_db",
      "bw95_hz",
      "noise_centroid_hz"
    ]
  },
  "n_jobs": 6
}